# Copy this file to .streamlit/secrets.toml and fill in your own keys.
# .streamlit/secrets.toml is git-ignored -- never commit real API keys.

# Free-tier key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"

# Free access token from https://huggingface.co/settings/tokens
HF_API_TOKEN = "your-huggingface-token-here"
